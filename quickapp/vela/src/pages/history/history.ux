<!--
  history.ux - 历史记录页
  展示姿态识别历史记录、统计信息
-->
<template>
  <div class="page">
    <div class="top-bar">
      <div class="back-btn" onclick="goBack">
        <text class="back-text">← 返回</text>
      </div>
      <text class="page-title">历史记录</text>
    </div>

    <!-- 统计概览 -->
    <div class="stats-card">
      <div class="stat-row">
        <div class="stat-item">
          <text class="stat-value">{{totalCount}}</text>
          <text class="stat-label">总记录</text>
        </div>
        <div class="stat-item">
          <text class="stat-value">{{dominantPosture}}</text>
          <text class="stat-label">主要姿态</text>
        </div>
        <div class="stat-item">
          <text class="stat-value">{{avgConfidence}}</text>
          <text class="stat-label">平均置信度</text>
        </div>
      </div>
    </div>

    <!-- 姿态分布 -->
    <div class="dist-card">
      <text class="card-title">姿态分布</text>
      <div class="dist-row" for="{{distItems}}">
        <text class="dist-label">{{$item.label}}</text>
        <div class="dist-bar-bg">
          <div class="dist-bar-fill" style="width: {{$item.width}}px; background-color: {{$item.color}}"></div>
        </div>
        <text class="dist-value">{{$item.value}}</text>
      </div>
    </div>

    <!-- 最近记录列表 -->
    <div class="list-card">
      <text class="card-title">最近记录</text>
      <div class="list-empty" if="{{historyList.length === 0}}">
        <text class="empty-text">暂无历史记录</text>
      </div>
      <div class="list-item" for="{{historyList}}">
        <div class="item-dot" style="background-color: {{$item.color}}"></div>
        <div class="item-info">
          <text class="item-posture">{{$item.label}}</text>
          <text class="item-time">{{$item.timeText}}</text>
        </div>
        <text class="item-conf">{{$item.confText}}</text>
      </div>
    </div>

    <!-- 清空按钮 -->
    <div class="clear-btn" onclick="clearHistory" if="{{historyList.length > 0}}">
      <text class="clear-text">清空记录</text>
    </div>
  </div>
</template>

<script>
import storage from '@system.storage'
import router from '@system.router'
import { POSTURE_LABEL, POSTURE_COLOR } from '../../common/constants'

export default {
  private: {
    historyList: [],
    distItems: [],
    totalCount: '0',
    dominantPosture: '--',
    avgConfidence: '0%'
  },

  onInit() {
    this._loadHistory()
  },

  /** 加载历史记录 */
  _loadHistory() {
    storage.get({
      key: 'posture_history',
      success: (data) => {
        if (data) {
          try {
            const records = JSON.parse(data)
            this._processHistory(records)
          } catch (e) {
            console.error('[History] 解析失败: ' + e)
          }
        }
      },
      fail: (d, c) => {
        console.log('[History] 无历史数据: ' + c)
      }
    })
  },

  /** 处理历史数据 */
  _processHistory(records) {
    if (!records || records.length === 0) return

    this.totalCount = '' + records.length

    // 统计各姿态出现次数
    const counts = {}
    let totalConf = 0
    for (let i = 0; i < records.length; i++) {
      const p = records[i].posture
      counts[p] = (counts[p] || 0) + 1
      totalConf += records[i].confidence || 0
    }

    // 平均置信度
    this.avgConfidence = (totalConf / records.length * 100).toFixed(0) + '%'

    // 主要姿态
    let maxCount = 0
    let dominant = '--'
    const keys = Object.keys(counts)
    for (let i = 0; i < keys.length; i++) {
      if (counts[keys[i]] > maxCount) {
        maxCount = counts[keys[i]]
        dominant = POSTURE_LABEL[keys[i]] || keys[i]
      }
    }
    this.dominantPosture = dominant

    // 分布数据
    const distItems = []
    for (let i = 0; i < keys.length; i++) {
      const k = keys[i]
      const pct = counts[k] / records.length
      distItems.push({
        label: POSTURE_LABEL[k] || k,
        value: (pct * 100).toFixed(0) + '%',
        width: Math.floor(pct * 120),
        color: POSTURE_COLOR[k] || '#757575'
      })
    }
    this.distItems = distItems

    // 最近20条记录
    const recent = records.slice(-20).reverse()
    const list = []
    for (let i = 0; i < recent.length; i++) {
      const r = recent[i]
      const date = new Date(r.time)
      list.push({
        label: POSTURE_LABEL[r.posture] || '未知',
        color: POSTURE_COLOR[r.posture] || '#757575',
        timeText: this._formatTime(date),
        confText: (r.confidence * 100).toFixed(0) + '%'
      })
    }
    this.historyList = list
  },

  /** 格式化时间 */
  _formatTime(date) {
    const h = date.getHours().toString().padStart(2, '0')
    const m = date.getMinutes().toString().padStart(2, '0')
    const s = date.getSeconds().toString().padStart(2, '0')
    return h + ':' + m + ':' + s
  },

  /** 清空历史 */
  clearHistory() {
    storage.delete({
      key: 'posture_history',
      success: () => {
        this.historyList = []
        this.distItems = []
        this.totalCount = '0'
        this.dominantPosture = '--'
        this.avgConfidence = '0%'
      }
    })
  },

  /** 返回首页 */
  goBack() {
    router.back()
  }
}
</script>

<style>
