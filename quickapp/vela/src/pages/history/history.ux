.stats-card {
  background-color: #1a1a2e;
  border-radius: 12px;
  padding: 10px;
  margin-bottom: 8px;
}

.stat-row {
  flex-direction: row;
  justify-content: space-around;
}

.stat-item {
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 16px;
  font-weight: bold;
  color: #ffffff;
}

.stat-label {
  font-size: 10px;
  color: #888888;
  margin-top: 2px;
}

/* 分布卡片 */
.dist-card {
  background-color: #1a1a2e;
  border-radius: 12px;
  padding: 10px;
  margin-bottom: 8px;
}

.card-title {
  font-size: 13px;
  color: #aaaaaa;
  margin-bottom: 8px;
}

.dist-row {
  flex-direction: row;
  align-items: center;
  margin-bottom: 4px;
}

.dist-label {
  width: 40px;
  font-size: 12px;
  color: #cccccc;
}

.dist-bar-bg {
  flex: 1;
  height: 8px;
  background-color: #333333;
  border-radius: 4px;
  margin-left: 6px;
  margin-right: 6px;
}

.dist-bar-fill {
  height: 8px;
  border-radius: 4px;
}

.dist-value {
  width: 35px;
  font-size: 11px;
  color: #aaaaaa;
  text-align: right;
}

/* 列表卡片 */
.list-card {
  background-color: #1a1a2e;
  border-radius: 12px;
  padding: 10px;
  flex: 1;
}

.list-empty {
  justify-content: center;
  align-items: center;
  padding: 20px;
}

.empty-text {
  font-size: 14px;
  color: #555555;
}

.list-item {
  flex-direction: row;
  align-items: center;
  padding: 6px 0;
  border-bottom-width: 1px;
  border-bottom-color: #222222;
}

.item-dot {
  width: 8px;
  height: 8px;
  border-radius: 4px;
  margin-right: 8px;
}

.item-info {
  flex: 1;
  flex-direction: column;
}

.item-posture {
  font-size: 13px;
  color: #ffffff;
}

.item-time {
  font-size: 10px;
  color: #666666;
  margin-top: 1px;
}

.item-conf {
  font-size: 12px;
  color: #aaaaaa;
}

/* 清空按钮 */
.clear-btn {
  margin-top: 8px;
  height: 32px;
  border-radius: 16px;
  background-color: #333333;
  justify-content: center;
  align-items: center;
}

.clear-text {
  font-size: 13px;
  color: #F44336;
}
</style>
