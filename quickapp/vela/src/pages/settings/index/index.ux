  flex-direction: column;
  padding: 8px 10px;
  background-color: #0a0a1a;
  height: 100%;
}

.top-bar {
  flex-direction: row;
  align-items: center;
  margin-bottom: 10px;
}

.back-btn {
  padding: 4px 8px;
  margin-right: 8px;
}

.back-text {
  font-size: 14px;
  color: #4CAF50;
}

.page-title {
  font-size: 16px;
  font-weight: bold;
  color: #ffffff;
}

.setting-group {
  background-color: #1a1a2e;
  border-radius: 12px;
  padding: 10px;
  margin-bottom: 8px;
}

.group-title {
  font-size: 13px;
  color: #888888;
  margin-bottom: 8px;
}

.setting-item {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom-width: 1px;
  border-bottom-color: #222222;
}

.item-label {
  font-size: 14px;
  color: #ffffff;
}

.item-value {
  font-size: 13px;
  color: #aaaaaa;
}

.item-check {
  font-size: 16px;
  color: #4CAF50;
}

.switch {
  width: 44px;
  height: 24px;
  border-radius: 12px;
  justify-content: center;
  padding: 2px;
}

.switch-on {
  background-color: #4CAF50;
  align-items: flex-end;
}

.switch-off {
  background-color: #555555;
  align-items: flex-start;
}

.switch-thumb {
  width: 20px;
  height: 20px;
  border-radius: 10px;
  background-color: #ffffff;
}

.reset-btn {
  margin-top: 8px;
  height: 36px;
  border-radius: 18px;
  background-color: #333333;
  justify-content: center;
  align-items: center;
}

.reset-text {
  font-size: 14px;
  color: #FF9800;
}
</style>
